# Frontend Environment Variables

# Backend API origin (no /api/denote). Leave empty locally to use Vite proxy.
# VITE_API_BASE_URL=https://denote-jstm.onrender.com

# Or full API base including /api/denote (also supported):
# VITE_API_URL=https://denote-jstm.onrender.com/api/denote

# College email domain restriction (must match backend ALLOWED_EMAIL_DOMAIN)
VITE_ALLOWED_EMAIL_DOMAIN=bmsce.ac.in
# VITE_ALLOWED_EMAIL_DOMAINS=bmsce.ac.in,another.edu

# Google Identity Services client ID (OAuth 2.0 Web client)
VITE_GOOGLE_CLIENT_ID=

# Optional IPFS gateway for note preview links
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/
