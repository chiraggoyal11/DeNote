# Backend (config.env or Render Environment)
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/denote
JWT_SECRET=change_me
PINATA=

# Restrict register/login/Google to these college email domains (comma-separated)
ALLOWED_EMAIL_DOMAIN=bmsce.ac.in
# ALLOWED_EMAIL_DOMAINS=bmsce.ac.in,another.edu

# Google OAuth 2.0 (same Client ID as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Email OTP (optional — if unset, OTP is printed in server logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS OTP via Twilio (optional — if unset, OTP is printed in server logs)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Temporary hardcoded OTP 123456 (set false when using SendGrid/Twilio)
OTP_HARDCODED=true

# Optional IPFS HTTP gateway base (default https://ipfs.io/ipfs/)
IPFS_GATEWAY=https://ipfs.io/ipfs/
